rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    // REGRA PRINCIPAL: um usuário só acessa os próprios dados.
    // Toda coleção raiz guarda o dono (via campo) ou é vinculada pelo ID.
    // ────────────────────────────────────────────────────────────────────────

    // users: somente o próprio usuário
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null &&
                                     request.auth.uid == userId;
    }

    // vehicles: somente o dono
    match /vehicles/{vehicleId} {
      allow create: if request.auth != null &&
                       request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null &&
                                     resource.data.user_id == request.auth.uid;

      // Leitura de documentos filhos (regras abaixo ainda se aplicam
      // individualmente, pois o Firestore não herda de parent no rules).
    }

    // manutenções/gastos/lembretes: só de veículos do próprio usuário
    // (ownership indireta via `vehicle_id` → vehicles.user_id).
    match /maintenance_records/{docId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)) &&
        get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id))
            .data.user_id == request.auth.uid;
      // Em create, usamos request.resource.data (ainda não existe resource).
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/vehicles/$(
            request.resource.data.vehicle_id)).data.user_id == request.auth.uid;
    }

    match /reminders/{docId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)) &&
        get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id))
            .data.user_id == request.auth.uid;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/vehicles/$(
            request.resource.data.vehicle_id)).data.user_id == request.auth.uid;
    }

    match /expenses/{docId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)) &&
        get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id))
            .data.user_id == request.auth.uid;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/vehicles/$(
            request.resource.data.vehicle_id)).data.user_id == request.auth.uid;
    }

    // subscriptions: somente a própria assinatura
    match /subscriptions/{docId} {
      allow create: if request.auth != null &&
                       request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if request.auth != null &&
                                     resource.data.user_id == request.auth.uid;
    }

    // Bloqueia qualquer outra coleção não mapeada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
